					"s3",
					"i14"
				],
				"technique": [
					"stir-fry"
				],
				"durationMin": 3
			},
			{
				"id": "s5",
				"text": "Add the rest of the coconut milk, eggplants and lime leaves and simmer until the eggplant is tender and the chicken reaches 74 °C.",
				"uses": [
					"s4",
					"i15",
					"i16"
				],
				"technique": [
					"simmer"
				],
				"durationMin": 10,
				"heat": "medium-low"
			},
			{
				"id": "s6",
				"text": "Season with fish sauce and palm sugar, stir in the basil and top with red chili. Serve with jasmine rice.",
				"uses": [
					"s5",
					"i17",
					"i18",
					"i19",
					"i20"
				],
				"technique": []
			}
		],
		"notes": {
			"techniques": "The coconut cream is cooked until it separates, then the paste is fried in that fat rather than in added oil.",
			"chemistry": "Cracking coconut cream evaporates water until the fat droplets coalesce; many chili and herb aromas dissolve in that fat.",
			"spiceProfile": "Hot and herbal: fresh green chilies, lemongrass, galangal and makrut lime, with sweet basil and a salty-sweet finish.",
			"variations": "Homemade paste is greener, hotter and fresher-tasting than jarred paste. Leftover paste keeps a week in the fridge."
		}
