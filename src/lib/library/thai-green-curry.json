		"steps": [
			{
				"id": "s1",
				"text": "Grind the toasted spices and pepper to a powder, then pound or blend with the other paste ingredients to a fine paste.",
				"uses": [
					"i1",
					"i2",
					"i3",
					"i4",
					"i5",
					"i6",
					"i7",
