					"i12"
				],
				"technique": [
					"grind",
					"blend"
				],
				"durationMin": 20
			},
			{
				"id": "s2",
				"text": "Simmer the thick cream from the top of the coconut milk in a wok until it splits and the oil appears.",
				"uses": [
					"i13"
				],
				"technique": [
					"reduce"
				],
				"durationMin": 5,
				"heat": "medium",
				"critical": "Let the coconut cream \"crack\" before adding paste; this is what fries the paste and releases its aroma."
			},
			{
				"id": "s3",
				"text": "Fry 4–5 tbsp of the paste in the coconut oil until very fragrant.",
				"uses": [
					"s1",
					"s2"
				],
				"technique": [
					"fry"
				],
				"durationMin": 3,
				"heat": "medium"
			},
			{
				"id": "s4",
				"text": "Add the chicken and stir until coated and turning opaque.",
