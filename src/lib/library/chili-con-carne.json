				"heat": "medium"
			},
			{
				"id": "s4",
				"text": "Return the beef, add the chile purée, chipotle and remaining stock, and simmer partly covered until the beef is very tender.",
				"uses": [
					"s1",
					"s3",
					"i11"
				],
				"technique": [
					"braise"
				],
				"durationMin": 150,
				"heat": "low"
			},
			{
