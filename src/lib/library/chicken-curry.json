		"steps": [
			{
				"id": "s1",
				"text": "Heat the oil and fry the cumin seeds, bay leaf, cinnamon and cardamom until fragrant.",
				"uses": [
					"i1",
					"i2",
					"i3",
					"i4",
					"i5"
				],
				"technique": [
					"bloom"
				],
				"durationMin": 1,
				"heat": "medium"
			},
			{
				"id": "s2",
				"text": "Add the onions and fry, stirring, until deep golden brown.",
				"uses": [
					"s1",
					"i6"
				],
				"technique": [
					"fry"
				],
				"durationMin": 15,
				"heat": "medium",
				"critical": "Take the onions to an even deep golden colour; pale onions give a thin, sweet curry, burnt ones a bitter one."
			},
			{
				"id": "s3",
				"text": "Add ginger and garlic and fry for a minute, then add turmeric, chili and coriander with a splash of water.",
				"uses": [
					"s2",
					"i7",
					"i8",
					"i9",
					"i10",
					"i11"
				],
				"technique": [
					"fry"
				]
			},
			{
				"id": "s4",
				"text": "Add the tomatoes and cook until thick and the oil separates at the edges.",
				"uses": [
					"s3",
					"i12"
				],
				"technique": [
					"fry",
					"reduce"
				],
				"durationMin": 8,
				"heat": "medium"
			},
			{
				"id": "s5",
				"text": "Add the chicken and salt and stir to coat. Fry for a few minutes until the outside turns opaque.",
				"uses": [
					"s4",
					"i13",
					"i14"
				],
				"technique": [
					"saute"
				],
				"durationMin": 5,
				"heat": "medium-high"
			},
			{
				"id": "s6",
				"text": "Add the water, cover and simmer until the chicken is tender and reaches 74 °C inside.",
				"uses": [
					"s5",
					"i15"
				],
				"technique": [
					"simmer"
				],
				"durationMin": 15,
				"heat": "low"
			},
			{
				"id": "s7",
				"text": "Stir in garam masala and cilantro and serve with rice or roti.",
				"uses": [
					"s6",
					"i16",
					"i17"
				],
				"technique": []
			}
		],
		"notes": {
			"techniques": "The flavour comes from the bhuna stage: frying the onion, aromatics and tomato until the oil separates before the meat goes in.",
			"chemistry": "Long browning of the onions develops sugars and Maillard flavours. Many spice aromas are fat-soluble, so blooming them in oil releases more flavour.",
			"spiceProfile": "Warm whole spices (cinnamon, cardamom, cumin) with earthy turmeric and coriander and mild heat from Kashmiri chili. Garam masala at the end adds fresh aroma.",
			"variations": "A tomato-onion base without cream or coconut. The Kerala version uses coconut milk and curry leaves, while British and Swedish home versions use curry powder and cream."
		}
	},
