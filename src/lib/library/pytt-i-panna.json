		"steps": [
			{
				"id": "s1",
				"text": "Rinse the raw potato cubes and pat them very dry. Fry in oil and half the butter, turning now and then, until golden and tender.",
				"uses": [
					"i1",
					"i3",
					"i2"
				],
				"technique": [
					"fry"
				],
				"durationMin": 20,
				"heat": "medium",
				"critical": "Dry the potatoes well and do not stir too often, or they will not crisp."
			},
			{
				"id": "s2",
				"text": "Fry the onion soft and golden in a separate pan, then add the meat and ham and fry until browned.",
				"uses": [
					"i4",
					"i5",
					"i6"
				],
				"technique": [
					"fry"
				],
				"durationMin": 8,
				"heat": "medium-high"
			},
			{
				"id": "s3",
				"text": "Combine with the potatoes, season and keep warm.",
				"uses": [
					"s1",
					"s2",
					"i7",
					"i8"
				],
				"technique": [
					"toss"
				]
			},
			{
				"id": "s4",
				"text": "Fry the eggs sunny side up and serve on top with pickled beetroot and parsley.",
				"uses": [
					"s3",
					"i9",
					"i10",
					"i11"
				],
				"technique": [
					"fry"
				],
				"durationMin": 3,
				"heat": "medium"
			}
		],
		"notes": {
			"techniques": "Potatoes, onion and meat are fried separately so each browns properly, then combined.",
			"chemistry": "Rinsing removes surface starch so the cubes crisp instead of sticking; dry surfaces brown by the Maillard reaction.",
			"spiceProfile": "Simple: salt, pepper and onion, with sweet-sour beetroot and runny yolk.",
			"variations": "The traditional Swedish hash with raw diced potatoes, leftover roast and ham, fried egg and pickled beetroot."
		}
