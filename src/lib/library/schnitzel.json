					"s3",
					"i9",
					"i10"
				],
				"technique": [
					"drain",
					"serve"
				]
			}
		],
		"notes": {
			"techniques": "Swirling the pan so hot fat rolls over the top makes the crust lift into loose waves (soufflé).",
			"chemistry": "Steam from the meat and egg puffs the coating, while the thin meat cooks through in the same few minutes.",
			"spiceProfile": "Simple: salt, white pepper and lemon.",
			"variations": "Only veal may be called Wiener Schnitzel in Austria; pork versions are \"Wiener Art\", and Jägerschnitzel comes with mushroom sauce."
		}
