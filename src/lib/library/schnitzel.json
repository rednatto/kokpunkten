		"steps": [
			{
				"id": "s1",
				"text": "Pound the cutlets between cling film to 4 mm thick. Season with salt and pepper.",
				"uses": [
					"i1",
					"i2",
					"i3"
				],
				"technique": [
					"pound",
					"season"
				]
			},
			{
				"id": "s2",
				"text": "Lightly beat the eggs with the cream. Dredge each cutlet in flour, then egg, then breadcrumbs, pressing very lightly.",
				"uses": [
					"s1",
					"i4",
					"i5",
					"i6",
					"i7"
				],
				"technique": [
					"bread"
				],
				"critical": "Bread just before frying and do not press the crumbs on, so the coating can puff away from the meat."
			},
			{
				"id": "s3",
				"text": "Heat the fat to about 170 °C, 1–2 cm deep. Fry the schnitzels, swirling the pan so the fat washes over the top, until the coating puffs and turns golden.",
				"uses": [
					"s2",
					"i8"
				],
				"technique": [
					"shallow-fry"
				],
				"durationMin": 4,
				"heat": "medium-high",
				"tempC": 170
			},
			{
				"id": "s4",
				"text": "Drain briefly on paper and serve at once with lemon and parsley.",
