		"steps": [
			{
				"id": "s1",
				"text": "Blanch the chicken in boiling water for 5 minutes, drain and rinse off the scum.",
				"uses": [
					"i1"
				],
				"technique": [
					"blanch"
				],
				"durationMin": 5,
				"heat": "high"
			},
			{
				"id": "s2",
				"text": "Cover the chicken with the fresh water, add ginger, garlic and scallion greens and simmer very gently, skimming, without a lid.",
				"uses": [
					"s1",
					"i2",
					"i4",
					"i5",
					"i6"
				],
				"technique": [
					"simmer"
				],
				"durationMin": 180,
				"heat": "low",
				"critical": "Keep the broth at a bare simmer so it stays clear; boiling clouds and greases it."
			},
			{
				"id": "s3",
				"text": "Add the kombu for the last 30 minutes, then strain the broth through a fine sieve.",
				"uses": [
					"s2",
					"i3"
				],
				"technique": [
					"simmer",
					"strain"
				],
				"durationMin": 30,
				"heat": "low"
			},
			{
				"id": "s4",
				"text": "Bring soy, mirin, sake and sugar to a simmer with 2 dl water to make a braising liquid. Braise the pork, covered and turning, until tender. Reserve the liquid as tare.",
				"uses": [
					"i7",
					"i8",
					"i9",
					"i11",
					"i12"
				],
				"technique": [
					"braise"
				],
				"durationMin": 120,
				"heat": "low"
			},
			{
				"id": "s5",
				"text": "Boil the eggs for 6½ minutes, chill in ice water, peel and marinate in some of the cooled tare.",
				"uses": [
					"s4",
					"i10"
				],
				"technique": [
					"boil",
					"marinate"
				],
				"durationMin": 7,
				"critical": "Exactly 6½ minutes gives a jammy yolk."
			},
			{
				"id": "s6",
				"text": "Cook the noodles according to the package, usually 1–2 minutes, and drain well.",
				"uses": [
					"i13"
				],
				"technique": [
					"boil"
				],
				"durationMin": 2,
				"heat": "high"
			},
			{
				"id": "s7",
				"text": "Put 3 tbsp tare in each bowl, pour in 4 dl hot broth, add the noodles, and top with sliced pork, halved eggs, menma, nori and scallion whites.",
				"uses": [
					"s3",
					"s4",
					"s5",
					"s6",
					"i14",
					"i15"
				],
				"technique": []
			}
		],
		"notes": {
			"techniques": "Ramen is assembled from separate parts: broth, tare (the seasoning), noodles, toppings and sometimes aroma oil. The broth is unsalted; the tare seasons each bowl.",
			"chemistry": "Gentle simmering dissolves collagen into gelatin, giving body, while keeping fat and proteins from emulsifying into a cloudy broth. Kombu adds glutamate for umami.",
			"spiceProfile": "Clean, savoury and salty from soy, with ginger and scallion.",
			"variations": "A clear, soy-seasoned broth, the classic Tokyo style. Tonkotsu is milky and pork-based, and miso ramen is heartier and quicker."
		}
