		"steps": [
			{
				"id": "s1",
				"text": "Poach the chicken with half the onion, 2 garlic cloves and the salt in the water until 74 °C inside. Shred and keep the broth.",
				"uses": [
					"i1",
					"i2",
					"i3",
					"i4",
					"i5"
				],
				"technique": [
					"poach",
					"shred"
				],
				"durationMin": 20,
				"heat": "medium-low"
			},
			{
				"id": "s2",
				"text": "Toast the chiles a few seconds per side in a dry pan, soak them in 5 dl hot broth, then blend with the remaining garlic, oregano and cumin.",
				"uses": [
					"s1",
					"i3",
					"i6",
					"i7",
					"i8",
					"i9"
				],
				"technique": [
					"toast",
					"soak",
					"blend"
				],
				"durationMin": 15
			},
			{
				"id": "s3",
				"text": "Fry the sauce in 1 tbsp oil until darker and slightly thick.",
				"uses": [
					"s2",
					"i10"
				],
				"technique": [
					"fry"
				],
				"durationMin": 8,
				"heat": "medium",
				"critical": "Use a deep pan; the sauce spatters hard when it hits the oil."
			},
			{
				"id": "s4",
				"text": "Pass each tortilla briefly through hot oil, dip in sauce, fill with chicken and roll.",
				"uses": [
					"s1",
					"s3",
					"i11"
				],
				"technique": [
					"fry",
					"dip",
					"roll"
				]
			},
			{
				"id": "s5",
				"text": "Arrange in a dish, spoon over remaining sauce and bake at 180 °C until hot, then top with queso fresco, crema and the remaining onion.",
				"uses": [
					"s4",
					"i12",
					"i13",
					"i2"
				],
				"technique": [
					"bake",
					"garnish"
				],
				"durationMin": 15,
				"tempC": 180
			}
		],
		"notes": {
			"techniques": "Frying each tortilla briefly in oil makes it pliable and stops it from falling apart in the sauce.",
			"chemistry": "Frying the chile purée concentrates it and caramelises its sugars, which takes away the raw chile taste.",
			"spiceProfile": "Earthy, mildly hot guajillo and ancho with oregano and cumin.",
			"variations": "Red sauce from dried chiles with fresh cheese on top. Verdes use a tomatillo sauce, and Tex-Mex enchiladas are baked under melted cheddar."
		}
