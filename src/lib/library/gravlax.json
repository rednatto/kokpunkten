		"steps": [
			{
				"id": "s1",
				"text": "Freeze the salmon at −20 °C for at least 24 hours and thaw in the fridge, unless it is sold as safe to eat raw.",
				"uses": [
					"i1"
				],
				"technique": [
					"freeze"
