		"steps": [
			{
				"id": "s1",
				"text": "Soak the porcini in the hot water, then chop them. Strain the liquid into the stock and keep it at a simmer.",
				"uses": [
					"i1",
					"i2",
					"i3"
				],
				"technique": [
					"soak"
				],
				"durationMin": 20
			},
			{
				"id": "s2",
				"text": "Fry the fresh mushrooms in the oil and a knob of butter until browned. Add garlic, season and set aside.",
				"uses": [
					"i4",
					"i6",
					"i5",
					"i8"
				],
				"technique": [
					"saute"
				],
				"durationMin": 8,
				"heat": "high"
			},
			{
				"id": "s3",
				"text": "Melt half the remaining butter and sweat the shallots until soft.",
				"uses": [
					"i5",
					"i7"
				],
				"technique": [
					"sweat"
				],
				"durationMin": 4,
				"heat": "medium-low"
			},
			{
				"id": "s4",
				"text": "Add the rice and toast, stirring, until the grains are hot and translucent at the edges. Add the wine and let it evaporate.",
				"uses": [
					"s3",
					"i9",
					"i10"
				],
				"technique": [
					"toast",
					"deglaze"
				],
				"durationMin": 3,
				"heat": "medium"
			},
			{
				"id": "s5",
				"text": "Add the porcini, then the hot stock a ladle at a time, stirring often and waiting until each is absorbed.",
				"uses": [
					"s1",
					"s4"
				],
				"technique": [
					"simmer",
					"stir"
				],
				"durationMin": 17,
				"heat": "medium"
			},
			{
				"id": "s6",
				"text": "When the rice is just al dente, stir in the fried mushrooms. Off the heat, beat in the rest of the butter and the parmesan. Season, cover and rest 2 minutes, then add parsley.",
				"uses": [
					"s2",
					"s5",
					"i5",
					"i11",
					"i13",
					"i14",
					"i12"
				],
				"technique": [
					"emulsify",
					"rest"
				],
				"durationMin": 2,
				"critical": "Stop while the rice still has bite and the risotto flows like a wave (all'onda); it keeps cooking off the heat."
			}
		],
		"notes": {
			"techniques": "Toasting the grains, adding hot stock gradually and finishing off the heat with butter and cheese (mantecatura).",
			"chemistry": "Stirring rubs amylopectin starch off the grain surface, which thickens the liquid. Cold butter and cheese emulsify into that starchy liquid for creaminess.",
			"spiceProfile": "Deep, woody porcini with nutty parmesan and a little white wine acidity.",
			"variations": "The classic stirred method, with soaked dried porcini for depth and fresh mushrooms for texture."
		}
