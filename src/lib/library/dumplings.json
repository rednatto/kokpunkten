		"steps": [
			{
				"id": "s1",
				"text": "Mix the flour with the water to a firm dough and knead until smooth. Cover and rest.",
				"uses": [
					"i1",
					"i2"
				],
				"technique": [
					"knead",
					"rest"
				],
				"durationMin": 30
			},
			{
				"id": "s2",
				"text": "Toss the cabbage with the salt, leave for 15 minutes, then squeeze out as much water as possible.",
				"uses": [
					"i3",
					"i4"
				],
				"technique": [
					"salt"
				],
				"durationMin": 15,
				"critical": "Squeeze the cabbage hard; wet filling makes soggy dumplings that burst."
			},
			{
				"id": "s3",
				"text": "Stir the pork with ginger, scallions, soy, Shaoxing wine, sesame oil and pepper in one direction until sticky, then mix in the cabbage.",
				"uses": [
					"s2",
					"i5",
					"i6",
					"i7",
					"i8",
					"i9",
					"i10",
					"i11"
				],
				"technique": [
					"mix"
				]
			},
			{
				"id": "s4",
				"text": "Roll the dough into a log, cut into about 40 pieces and roll each into an 8 cm round with thinner edges.",
				"uses": [
					"s1"
				],
				"technique": [
					"roll"
				]
			},
			{
				"id": "s5",
				"text": "Put a teaspoon of filling on each wrapper, fold in half and pleat or pinch tightly closed.",
				"uses": [
					"s3",
					"s4"
				],
				"technique": [
					"fold"
				]
			},
			{
				"id": "s6",
				"text": "Boil the dumplings in batches. When the water boils again, add a cup of cold water; repeat twice. They are done when they float and puff, and the filling reaches 71 °C.",
				"uses": [
					"s5"
				],
				"technique": [
					"boil"
				],
				"durationMin": 8,
				"heat": "high"
			},
			{
				"id": "s7",
				"text": "Serve with vinegar mixed with chili oil and garlic.",
				"uses": [
					"s6",
					"i12",
					"i13",
					"i14"
				],
				"technique": []
			}
		],
		"notes": {
			"techniques": "Homemade dough gives thick, chewy wrappers that hold up to boiling. Adding cold water during boiling cooks the filling through without bursting the wrappers.",
			"chemistry": "Stirring the pork with salt in one direction dissolves myosin proteins, which bind the filling into a springy, juicy mass. Gluten in the rested dough makes wrappers elastic.",
			"spiceProfile": "Savoury and clean: ginger, scallion, white pepper and sesame, with a sharp vinegar dip.",
			"variations": "The northern Chinese family dumpling, boiled with homemade wrappers. Potstickers are pan-fried for a crisp base, and wontons are thin-skinned and served in soup."
		}
