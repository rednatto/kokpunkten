					"melt"
				],
				"heat": "medium"
			},
			{
				"id": "s3",
				"text": "Pour in the eggs and stir quickly with a fork while shaking the pan until small soft curds form and the top is still wet.",
				"uses": [
					"s1",
					"s2"
				],
				"technique": [
					"scramble"
				],
				"heat": "medium",
				"critical": "The outside must stay pale yellow with no browning; pull it at about one minute."
			},
			{
				"id": "s4",
				"text": "Smooth the surface, then tilt the pan and roll the omelette onto a plate, seam side down. Sprinkle with chives.",
				"uses": [
					"s3",
					"i4"
				],
				"technique": [
					"roll"
				]
			}
		],
		"notes": {
			"techniques": "Constant stirring creates fine curds, and rolling traps a creamy, barely set centre.",
			"chemistry": "Egg proteins start to set around 62–65 °C; keeping the heat moderate and the cooking short prevents tough, rubbery curds.",
			"variations": "Pale, smooth and soft inside, unlike the browned, filled American omelette."
		}
