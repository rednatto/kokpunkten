		"steps": [
			{
				"id": "s1",
				"text": "Beat the eggs with salt until completely uniform, with no streaks of white.",
				"uses": [
					"i1",
					"i3"
				],
				"technique": [
					"whisk"
				]
			},
			{
				"id": "s2",
				"text": "Heat the butter in the pan until it foams but does not brown.",
