				"technique": [
					"saute"
				],
				"durationMin": 12,
				"heat": "medium-high"
			},
			{
				"id": "s7",
				"text": "Remove the herbs, skim the fat, reduce the sauce if thin, and season. Stir in the onions and mushrooms and scatter with parsley.",
				"uses": [
					"s5",
					"s6",
					"i12",
					"i13",
					"i17"
				],
				"technique": [
					"reduce",
					"finish"
				],
				"durationMin": 10
			}
		],
		"notes": {
			"techniques": "Searing in batches and braising gently below a full boil makes the meat tender without drying it.",
			"chemistry": "Collagen in chuck or shin converts to gelatin over long, moist cooking, giving silky meat and a glossy sauce.",
