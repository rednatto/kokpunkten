				"critical": "Dry meat and an uncrowded pan are needed for a deep brown crust."
			},
			{
				"id": "s4",
				"text": "Brown the marinade vegetables in the same pot, then stir in flour and tomato paste and cook for 2 minutes.",
				"uses": [
					"s3",
					"i9",
					"i10"
				],
				"technique": [
					"saute"
				],
				"durationMin": 5
			},
			{
				"id": "s5",
				"text": "Return beef and lardons, add the marinade wine, bouquet garni and stock. Bring to a simmer, cover and braise at 150 °C until the beef is fork-tender.",
				"uses": [
					"s4",
					"i11"
				],
				"technique": [
					"braise"
				],
				"durationMin": 180,
				"tempC": 150
			},
			{
				"id": "s6",
				"text": "Brown the pearl onions and mushrooms in butter until golden.",
				"uses": [
					"i14",
					"i15",
					"i16"
