		"steps": [
			{
				"id": "s1",
				"text": "Salt the eggplant slices and leave to drain, then pat dry.",
				"uses": [
					"i1",
					"i4"
				],
				"technique": [
					"salt"
				],
				"durationMin": 30
			},
			{
				"id": "s2",
				"text": "Brush eggplant and potato slices with oil and roast at 200 °C until golden and soft.",
				"uses": [
					"s1",
					"i2",
					"i3"
				],
				"technique": [
					"roast"
				],
				"durationMin": 25,
				"tempC": 200
			},
			{
				"id": "s3",
				"text": "Brown the lamb with onion and garlic, deglaze with wine, then add tomatoes, paste, cinnamon, allspice, bay and pepper. Simmer until thick and almost dry.",
				"uses": [
					"i7",
					"i5",
					"i6",
					"i8",
					"i9",
					"i10",
					"i11",
					"i12",
					"i13",
					"i14"
				],
				"technique": [
					"brown",
					"deglaze",
					"simmer"
				],
				"durationMin": 40,
				"heat": "medium-low",
				"critical": "Reduce until no liquid pools; a wet sauce makes the moussaka collapse."
			},
			{
				"id": "s4",
				"text": "Melt butter, cook the flour for 2 minutes, whisk in warm milk and simmer to a thick béchamel. Off the heat, beat in nutmeg, yolks and half the cheese.",
				"uses": [
					"i15",
					"i16",
					"i17",
					"i18",
					"i19",
					"i20"
				],
				"technique": [
					"whisk",
					"simmer"
				],
				"durationMin": 10,
				"heat": "medium"
			},
			{
				"id": "s5",
				"text": "Layer potatoes, half the eggplant, the meat and the rest of the eggplant. Spread the béchamel on top and sprinkle with the remaining cheese.",
				"uses": [
					"s2",
					"s3",
					"s4"
				],
				"technique": [
					"layer"
				]
			},
			{
				"id": "s6",
				"text": "Bake at 180 °C until deep golden, then rest before cutting.",
				"uses": [
					"s5"
				],
				"technique": [
					"bake",
					"rest"
				],
				"durationMin": 50,
				"tempC": 180,
				"critical": "Rest at least 30 minutes or it slumps when cut."
			}
		],
		"notes": {
			"techniques": "Pre-roasting the vegetables instead of frying them uses less oil. A thick, yolk-enriched béchamel sets into a firm top layer.",
			"chemistry": "Salting draws water out of the eggplant through osmosis, so it absorbs less oil. The yolks set during baking and turn the béchamel into a sliceable custard.",
			"spiceProfile": "Warm cinnamon and allspice in the meat, nutmeg in the béchamel.",
			"variations": "The Greek version with eggplant, potato and a thick béchamel. The Balkan version is mostly potato with an egg-and-milk topping, and the lentil version is vegetarian."
		}
