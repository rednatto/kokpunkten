		"steps": [
			{
				"id": "s1",
				"text": "Cover the bones with water, boil hard for 10 minutes, then drain and rinse the bones and pot.",
				"uses": [
					"i1"
				],
				"technique": [
					"blanch"
				],
				"durationMin": 10,
				"heat": "high"
			},
			{
				"id": "s2",
				"text": "Char the onions and ginger in a dry pan or over a flame until blackened in places. Toast the spices in a dry pan until fragrant.",
				"uses": [
					"i4",
					"i5",
					"i6",
					"i7",
					"i8",
					"i9",
					"i10"
				],
				"technique": [
					"char",
					"toast"
				],
				"durationMin": 10,
				"heat": "medium-high"
			},
			{
				"id": "s3",
				"text": "Return the bones to the pot with the fresh water and brisket and bring to a bare simmer, skimming well.",
				"uses": [
					"s1",
					"i2",
					"i3"
				],
				"technique": [
					"simmer",
					"skim"
				],
				"durationMin": 15,
				"heat": "medium"
			},
			{
				"id": "s4",
				"text": "Add the charred aromatics and the spices in a muslin bag. Simmer gently, uncovered.",
				"uses": [
					"s2",
					"s3"
				],
				"technique": [
					"simmer"
				],
				"durationMin": 360,
				"heat": "low",
				"critical": "Never let the broth boil; keep skimming for a clear broth."
			},
			{
				"id": "s5",
				"text": "Remove the brisket after about 1.5 hours when tender, cool and slice thinly. Remove the spice bag after 2 hours so it does not turn bitter.",
				"uses": [
					"s4"
				],
				"technique": []
			},
			{
				"id": "s6",
				"text": "Strain the broth and season with fish sauce, rock sugar and salt. Keep it at a rolling boil for serving.",
				"uses": [
					"s4",
					"i11",
					"i12",
					"i13"
				],
				"technique": [
					"strain"
				]
			},
			{
				"id": "s7",
				"text": "Cook the noodles, divide between bowls, top with sliced brisket, raw sirloin, scallions and onion.",
				"uses": [
					"s5",
					"i14",
					"i15",
					"i16",
					"i17"
				],
				"technique": [
					"boil"
				],
				"durationMin": 2
			},
			{
				"id": "s8",
				"text": "Ladle boiling broth over so it cooks the raw beef, and serve with herbs, sprouts, lime, chili, hoisin and sriracha on the side.",
				"uses": [
					"s6",
					"s7",
					"i18",
					"i19",
					"i20",
					"i21",
					"i22",
					"i23",
					"i24"
				],
				"technique": [],
				"critical": "The broth must be at a full boil to cook the thin raw beef in the bowl."
			}
		],
		"notes": {
			"techniques": "A clear broth relies on blanching the bones, skimming and never boiling. Charring the onion and ginger adds sweetness and smokiness.",
			"chemistry": "Slow simmering extracts gelatin from bones for body. Charring caramelises the onion sugars and creates roasted flavours that colour the broth.",
			"spiceProfile": "Fragrant star anise and cinnamon with cloves and coriander, savoury fish sauce, and fresh herbs, lime and chili added at the table.",
			"variations": "Saigon-style with a full herb plate, hoisin and sriracha. Hanoi-style pho is clearer and garnished only with scallion, and pho ga uses chicken."
		}
