		"steps": [
			{
				"id": "s1",
				"text": "Heat the oil in the pan, season the chicken and rabbit with half the salt and brown them slowly on all sides.",
				"uses": [
					"i1",
					"i2",
					"i3",
					"i4"
				],
				"technique": [
					"sear"
				],
				"durationMin": 20,
				"heat": "medium"
			},
			{
				"id": "s2",
				"text": "Push the meat to the edges, add the green beans and garrofó and fry for a few minutes.",
				"uses": [
					"s1",
					"i5",
					"i6"
				],
				"technique": [
					"saute"
				],
				"durationMin": 5
			},
			{
				"id": "s3",
				"text": "Add the tomato and paprika and fry briefly, then pour in the water and saffron and simmer to make a broth in the pan.",
				"uses": [
					"s2",
					"i7",
					"i8",
					"i9",
					"i10"
				],
				"technique": [
					"simmer"
				],
				"durationMin": 20,
				"heat": "medium",
				"critical": "Fry the paprika only for seconds before the water goes in; burnt paprika turns bitter."
			},
			{
				"id": "s4",
				"text": "Scatter the rice evenly across the pan and do not stir again. Cook on high for 10 minutes, then lower the heat.",
				"uses": [
					"s3",
					"i11"
				],
				"technique": [
					"simmer"
				],
				"durationMin": 10,
				"heat": "high"
			},
			{
				"id": "s5",
				"text": "Lay the rosemary on top and cook on low until the liquid is absorbed and the rice is tender, then turn up the heat for a minute to form the socarrat.",
				"uses": [
					"s4",
					"i12"
				],
				"technique": [
					"simmer",
					"toast"
				],
				"durationMin": 9,
				"heat": "low"
			},
			{
				"id": "s6",
				"text": "Rest off the heat, covered with a cloth, before serving.",
				"uses": [
					"s5"
				],
				"technique": [
					"rest"
				],
				"durationMin": 5
			}
		],
		"notes": {
			"techniques": "The broth is made in the pan from the browned meat; once the rice goes in it is never stirred.",
			"chemistry": "Not stirring keeps the starch from making the rice creamy, and the dry heat at the end caramelises a crust (socarrat) on the bottom.",
			"spiceProfile": "Saffron, sweet paprika and a sprig of rosemary.",
			"variations": "The original Valencian paella with chicken, rabbit and beans; no seafood and no chorizo."
		}
