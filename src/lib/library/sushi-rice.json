		"steps": [
			{
				"id": "s1",
				"text": "Rinse the rice in cold water, swishing and draining, until the water runs almost clear. Drain for 15 minutes.",
				"uses": [
					"i1"
				],
				"technique": [
					"rinse"
				],
				"durationMin": 15,
				"critical": "Rinse well; surface starch left on the grains makes the rice pasty."
			},
			{
				"id": "s2",
				"text": "Cook the rice with the water and kombu: bring to a boil covered, then cook on the lowest heat for 13 minutes and rest off the heat, lid on, for 10 minutes.",
				"uses": [
					"s1",
					"i2",
					"i3"
				],
				"technique": [
					"boil",
					"steam",
					"rest"
				],
				"durationMin": 25,
				"heat": "low"
			},
			{
				"id": "s3",
				"text": "Warm the vinegar, sugar and salt until dissolved, then cool.",
				"uses": [
					"i4",
					"i5",
					"i6"
				],
				"technique": [
					"simmer"
				],
				"heat": "low"
			},
			{
				"id": "s4",
				"text": "Turn the hot rice into a wide bowl, remove the kombu, and fold in the vinegar with slicing strokes while fanning to cool it to body temperature. Cover with a damp cloth.",
				"uses": [
					"s2",
					"s3"
				],
				"technique": [
					"fold"
				],
				"durationMin": 5
			},
			{
				"id": "s5",
				"text": "Place half a nori sheet, shiny side down, on the mat. With wet hands spread about 80 g rice evenly, leaving 1 cm free at the far edge.",
				"uses": [
					"s4",
					"i7"
				],
				"technique": [
					"spread"
				]
			},
			{
				"id": "s6",
				"text": "Smear a little wasabi across the rice, lay a line of tuna or cucumber on top, and roll tightly with the mat.",
				"uses": [
					"s5",
					"i8",
					"i9",
					"i10"
				],
				"technique": [
					"roll"
				]
			},
			{
				"id": "s7",
				"text": "Cut each roll into 6 pieces with a wet sharp knife and serve with soy and pickled ginger.",
				"uses": [
					"s6",
					"i11",
					"i12"
				],
				"technique": [
					"slice"
				]
			}
		],
		"notes": {
			"techniques": "Sushi rice is seasoned while hot and cooled quickly by fanning, which gives a glossy surface. Hosomaki are thin rolls with one filling and nori outside.",
			"chemistry": "Hot rice absorbs the vinegar seasoning better; acetic acid lowers pH, which slows bacterial growth. Raw fish should be sushi-grade or frozen to −20 °C for at least 7 days to kill parasites.",
			"spiceProfile": "Lightly sweet-sour rice with the sharp heat of wasabi and clean fish and cucumber flavours.",
			"variations": "Traditional thin rolls with a single filling. Inside-out rolls such as the California roll put rice outside and use cooked or no fish."
		}
