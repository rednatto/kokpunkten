		"steps": [
			{
				"id": "s1",
				"text": "Rinse the rice until the water runs nearly clear, then cook it with 480 ml water.",
				"uses": [
					"i1"
				],
				"technique": [
					"boil"
				],
				"durationMin": 30
			},
			{
				"id": "s2",
				"text": "Melt the butter over low heat, stir in the flour and cook, stirring, until the roux is light brown. Stir in the curry powder and garam masala for 30 seconds and set aside.",
				"uses": [
					"i2",
					"i3",
					"i4",
					"i5"
				],
				"technique": [
					"toast"
				],
				"durationMin": 12,
				"heat": "low",
				"critical": "Stir constantly; a scorched roux turns bitter."
			},
			{
				"id": "s3",
				"text": "Fry the onions in the oil until soft and deep golden, then add garlic and ginger for 1 minute.",
				"uses": [
					"i6",
					"i7",
					"i8",
					"i9"
				],
				"technique": [
					"saute"
				],
				"durationMin": 15,
				"heat": "medium"
			},
			{
				"id": "s4",
				"text": "Add carrots, potatoes, stock, apple, soy, Worcestershire and honey. Simmer until the vegetables are tender.",
				"uses": [
					"s3",
					"i10",
					"i11",
					"i12",
					"i13",
					"i14",
					"i15",
					"i16"
				],
				"technique": [
					"simmer"
				],
				"durationMin": 20,
				"heat": "medium-low"
			},
			{
				"id": "s5",
				"text": "Whisk the roux into the pot and simmer, stirring, until the sauce thickens.",
				"uses": [
					"s4",
					"s2"
				],
				"technique": [
					"whisk",
					"simmer"
				],
				"durationMin": 5,
				"heat": "low"
			},
			{
				"id": "s6",
				"text": "Score the fat edge of the pork, pound lightly and season. Dredge in flour, dip in egg, then press into panko.",
				"uses": [
					"i17",
					"i18",
					"i19",
					"i20",
					"i21",
					"i22"
				],
				"technique": [
					"bread"
				]
			},
			{
				"id": "s7",
				"text": "Deep-fry the cutlets at 170 °C until golden and the pork reaches 63 °C inside, then rest on a rack.",
				"uses": [
					"s6",
					"i23"
				],
				"technique": [
					"deep-fry",
					"rest"
				],
				"durationMin": 6,
				"heat": "medium-high",
				"critical": "Check the oil temperature; too cool gives greasy crumbs, too hot burns them before the pork is cooked."
			},
			{
				"id": "s8",
				"text": "Slice the katsu and serve over rice with the curry sauce alongside.",
				"uses": [
					"s1",
					"s5",
					"s7"
				],
				"technique": [
					"assemble"
				]
			}
		],
		"notes": {
			"techniques": "A brown roux made separately and whisked in at the end thickens the curry, just as the commercial blocks do. Panko fried at 170 °C gives a crisp, light crust.",
			"chemistry": "Toasting the flour in butter triggers Maillard browning for a nutty, roasted flavour. The starch then gelatinises in the hot stock, which thickens the sauce. Pork is safe at 63 °C followed by a short rest.",
			"spiceProfile": "Mild and sweet-savoury: curry powder and garam masala warmed by ginger, rounded with apple and honey, deepened with soy and Worcestershire.",
			"variations": "This version builds the roux from scratch with pork tonkatsu. The weeknight style uses ready-made roux blocks, and the British café style blends a smooth, sweeter sauce."
		}
